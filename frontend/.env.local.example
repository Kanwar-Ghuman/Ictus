# Optional. Copy to frontend/.env.local only to override the defaults.
# Server-side only (never NEXT_PUBLIC_*): the browser must not see these.

# Where the trading bot listens (default http://127.0.0.1:8002).
# TRADING_API_BASE=http://127.0.0.1:8002

# The dashboard token is read from ../model/.env by default.
# ICTUS_ENV_FILE=/absolute/path/to/model/.env

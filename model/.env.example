# Copy to model/.env and fill in. That file is gitignored; never commit real keys.
# Both keys are optional: without them the matching fetch commands are skipped.
# Variable names are configurable in model/config.yaml under `scraping`/`betting`.

# The Odds API (https://the-odds-api.com) — used by `octagon fetch-odds`.
ODDS_API_KEY=

# YouTube Data API v3 — used by `octagon fetch-media` / `fetch-context`.
YOUTUBE_API_KEY=

# A local secret between the dashboard and the bot, at least 32 characters.
# ./ictus.sh creates it when it is empty. It is not a Kalshi API key.
ICTUS_TRADING_TOKEN=

# Optional for practice (public quotes work without keys); required for demo
# and live. Demo mode needs keys created in Kalshi's demo environment.
KALSHI_API_KEY_ID=
# Absolute path to your downloaded RSA or Ed25519 PEM key. Never paste the key
# content into source code, a browser, or chat. *.pem / *.key are gitignored.
KALSHI_PRIVATE_KEY_PATH=
